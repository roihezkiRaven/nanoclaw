[Unit]
Description=Mirror the personal knowledge wiki to Google Drive
After=network-online.target gdrive-broker.service

[Service]
Type=oneshot
WorkingDirectory=/home/assistant/nanoclaw
ExecStart=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/tools/sync_knowledge_wiki.py --source /home/assistant/nanoclaw/data/timeless-wiki --drive-folder 12T_HdnBxiTqumlH3xocA88MTu3gJeu3Y
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/assistant/nanoclaw/data/timeless-wiki /home/assistant/nanoclaw/config/google

