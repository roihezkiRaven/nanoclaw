[Unit]
Description=Mirror the personal knowledge wiki to Google Drive
After=network-online.target gdrive-broker.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=60
WorkingDirectory=/home/assistant/nanoclaw
EnvironmentFile=/home/assistant/nanoclaw/.env
ExecStart=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/tools/publish_knowledge_wiki.py --source /home/assistant/nanoclaw/data/timeless-wiki --scope timeless --state-dir /home/assistant/nanoclaw/data/knowledge-publication/timeless --drive-folder ${TIMELESS_KNOWLEDGE_FOLDER_ID} --sync-state /home/assistant/nanoclaw/data/timeless-wiki/.drive-sync.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/assistant/nanoclaw/data/knowledge-publication /home/assistant/nanoclaw/data/timeless-wiki /home/assistant/nanoclaw/config/google
