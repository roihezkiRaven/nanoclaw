[Unit]
Description=Mirror the personal knowledge wiki to Google Drive
After=network-online.target gdrive-broker.service

[Service]
Type=oneshot
WorkingDirectory=/home/assistant/nanoclaw
EnvironmentFile=/home/assistant/nanoclaw/.env
ExecStartPre=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/scripts/validate-knowledge-wiki.py /home/assistant/nanoclaw/data/timeless-wiki
ExecStart=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/tools/sync_knowledge_wiki.py --source /home/assistant/nanoclaw/data/timeless-wiki --drive-folder ${TIMELESS_KNOWLEDGE_FOLDER_ID} --exclude-dir whatsapp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/assistant/nanoclaw/data/timeless-wiki /home/assistant/nanoclaw/config/google
