[Unit]
Description=Mirror WhatsApp knowledge digests to Google Drive
After=network-online.target gdrive-broker.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
TimeoutStartSec=20min
Restart=on-failure
RestartSec=60
WorkingDirectory=/home/assistant/nanoclaw
EnvironmentFile=/home/assistant/nanoclaw/.env
ExecStartPre=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/tools/audit_whatsapp_wiki.py --wiki /home/assistant/nanoclaw/data/knowledge-drafts/whatsapp --cache-dir /home/assistant/nanoclaw/data/knowledge-source-cache/whatsapp --archive-folder ${WHATSAPP_SOURCE_ROOT_ID} --state /home/assistant/nanoclaw/data/knowledge-publication/whatsapp/source-inventory.json
ExecStart=/home/assistant/nanoclaw/.venv-gdrive/bin/python /home/assistant/nanoclaw/tools/publish_knowledge_wiki.py --build-navigation --canonical-destination /home/assistant/nanoclaw/data/timeless-wiki --source /home/assistant/nanoclaw/data/knowledge-drafts/whatsapp --scope whatsapp --state-dir /home/assistant/nanoclaw/data/knowledge-publication/whatsapp --drive-folder ${WHATSAPP_KNOWLEDGE_FOLDER_ID} --sync-state /home/assistant/nanoclaw/data/timeless-wiki/.whatsapp-drive-sync.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/assistant/nanoclaw/data/knowledge-drafts/whatsapp /home/assistant/nanoclaw/data/knowledge-source-cache /home/assistant/nanoclaw/data/knowledge-publication /home/assistant/nanoclaw/data/timeless-wiki /home/assistant/nanoclaw/config/google
