# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/
.venv-gdrive/
**/__pycache__/

# Groups - per-installation state, not tracked
groups/*

# Per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md

# Secrets
*.keys.json
.env
.env*
config/

# Temp files
.tmp-*

# Manual/nohup service state (generated by setup on WSL or hosts without a
# service manager; snapshot by update-nanoclaw, never source-controlled)
start-nanoclaw.sh
nanoclaw.pid

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md
gcp_creds-*.json

# Private working material and generated backups
/claude_docs/*
!/claude_docs/future_features/
._*
*.pre-*
*.bak
*.backup
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
**/credentials.json
**/*-token.json
